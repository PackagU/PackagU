<?xml version="1.0" encoding="UTF-8"?>
<!-- 최종 시연 저장소(2026-10-28): 접속 정보 보호를 위해 주소를 이름표로 바꿨다. 분산 시뮬을 쓸 때만 아래 *_IP 를 실제 주소로 채운다(현장 주행에는 쓰지 않음).
 분산 시뮬(§4.5)용 Fast DDS unicast peer 설정.
     Wi-Fi AP가 멀티캐스트 discovery를 막을 때 양쪽 머신에서
     FASTRTPS_DEFAULT_PROFILES_FILE=/ros2_ws/scripts/fastdds_lan_peers.xml 로 지정.
     자기 자신 IP가 목록에 있어도 무해하므로 한 파일을 양쪽에서 공용한다.
     주 경로: 유선 직결 DESKTOP_WIRED_IP(데스크톱)/JETSON_WIRED_IP(Jetson) — NM jetson-link 공유 모드.
     예비: Wi-Fi LAN_PEER_A_IP/LAN_PEER_B_IP (Jetson Wi-Fi는 DDS 부하 시 불안정 — §1.22 참조). -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <participant profile_name="packagu_lan_peers" is_default_profile="true">
    <rtps>
      <builtin>
        <initialPeersList>
          <!-- 기본 멀티캐스트 locator — initialPeersList 지정 시 기본값이 대체되므로 반드시 명시.
               없으면 같은 호스트에서 늦게 뜬 참가자끼리(참가자 ID>=4) 상호 발견 불가
               (unicast peer는 ID 0~3 포트만 탐색) — orchestrator↔arm/world_swap/CLI 매칭 실패 실측. -->
          <locator>
            <udpv4>
              <address>239.255.0.1</address>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>DESKTOP_WIRED_IP</address>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>JETSON_WIRED_IP</address>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>LAN_PEER_A_IP</address>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>LAN_PEER_B_IP</address>
            </udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
